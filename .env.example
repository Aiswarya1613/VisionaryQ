# ---------------------------------------------------------
# VisionaryQ environment configuration
# ---------------------------------------------------------

# Pinecone
# Create a free Pinecone account and place your API key
# in your local .env file.
PINECONE_API_KEY=your_pinecone_api_key_here

PINECONE_INDEX_NAME=visionaryq


# Faster-Whisper
WHISPER_MODEL=small.en


# RAG retrieval
RAG_MIN_SCORE=0.30


# Local Ollama model
OLLAMA_MODEL=llama3.2:3b