# ---------------------------------------------------------
# VisionaryQ environment configuration
# ---------------------------------------------------------

# Pinecone
# Create a free Pinecone account and place your API key
# in your local .env file.
PINECONE_API_KEY=your_pinecone_api_key_here

PINECONE_INDEX_NAME=visionaryq


# Faster-Whisper
WHISPER_MODEL=small.en


# RAG retrieval
RAG_MIN_SCORE=0.30


# Local Ollama model
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# When running VisionaryQ inside Docker on Windows/macOS,
# override OLLAMA_HOST at container startup with:
# http://host.docker.internal:11434

# Optional: Hugging Face token for higher download rate limits.
# Faster-Whisper works without this, but authenticated downloads
# may be faster and less rate-limited.
# HF_TOKEN=your_huggingface_token_here